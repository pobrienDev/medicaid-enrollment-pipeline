# Copy to .env for local runs:  cp .env.example .env
# .env is gitignored. In GitHub Actions these come from repo secrets/variables.

# Local throwaway Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5432/enrollment

# data.medicaid.gov: State Medicaid and CHIP Applications, Eligibility
# Determinations, and Enrollment Data (public, no API key)
SOURCE_URL=https://data.medicaid.gov/api/1/datastore/query/6165f45b-ca93-5bb5-9d06-db29c692a360/0

# CSV fallback: set SOURCE_TYPE=csv and use this stable URL instead
# (the release-named file on download.medicaid.gov changes every month)
# SOURCE_URL=https://data.medicaid.gov/api/1/datastore/query/6165f45b-ca93-5bb5-9d06-db29c692a360/0/download?format=csv

# "api" or "csv"
SOURCE_TYPE=api

PAGE_SIZE=500
